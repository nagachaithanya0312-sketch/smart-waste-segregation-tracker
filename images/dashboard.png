<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 600 300" width="100%" height="100%">
  <rect width="600" height="300" rx="16" fill="#0f172a"/>
  <rect x="30" y="30" width="160" height="110" rx="10" fill="#10b981"/>
  <text x="110" y="80" font-family="Arial" font-size="14" font-weight="bold" fill="#ffffff" text-anchor="middle">Organic Waste</text>
  <rect x="220" y="30" width="160" height="110" rx="10" fill="#0284c7"/>
  <text x="300" y="80" font-family="Arial" font-size="14" font-weight="bold" fill="#ffffff" text-anchor="middle">Plastic Waste</text>
  <rect x="410" y="30" width="160" height="110" rx="10" fill="#4b6cb7"/>
  <text x="490" y="80" font-family="Arial" font-size="14" font-weight="bold" fill="#ffffff" text-anchor="middle">Paper Waste</text>
  <rect x="30" y="160" width="160" height="110" rx="10" fill="#00b4db"/>
  <text x="110" y="210" font-family="Arial" font-size="14" font-weight="bold" fill="#ffffff" text-anchor="middle">Glass Waste</text>
  <rect x="220" y="160" width="160" height="110" rx="10" fill="#cb2d3e"/>
  <text x="300" y="210" font-family="Arial" font-size="14" font-weight="bold" fill="#ffffff" text-anchor="middle">Hazardous</text>
  <rect x="410" y="160" width="160" height="110" rx="10" fill="#f857a6"/>
  <text x="490" y="210" font-family="Arial" font-size="14" font-weight="bold" fill="#ffffff" text-anchor="middle">E-Waste</text>
</svg>
