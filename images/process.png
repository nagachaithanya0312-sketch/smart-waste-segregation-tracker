<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 600 300" width="100%" height="100%">
  <rect width="600" height="300" rx="20" fill="#0f172a"/>
  <text x="300" y="40" font-family="Arial" font-size="18" font-weight="bold" fill="#10b981" text-anchor="middle">WORKING PROCESS TIMELINE</text>
  <path d="M 50 150 L 550 150" stroke="#0284c7" stroke-width="4" stroke-dasharray="6,6"/>
  <circle cx="100" cy="150" r="20" fill="#10b981"/>
  <text x="100" y="155" font-family="Arial" font-size="12" font-weight="bold" fill="#ffffff" text-anchor="middle">1</text>
  <text x="100" y="190" font-family="Arial" font-size="11" fill="#cbd5e1" text-anchor="middle">Input Item</text>
  <circle cx="230" cy="150" r="20" fill="#0284c7"/>
  <text x="230" y="155" font-family="Arial" font-size="12" font-weight="bold" fill="#ffffff" text-anchor="middle">2</text>
  <text x="230" y="190" font-family="Arial" font-size="11" fill="#cbd5e1" text-anchor="middle">Flask Backend</text>
  <circle cx="360" cy="150" r="20" fill="#f59e0b"/>
  <text x="360" y="155" font-family="Arial" font-size="12" font-weight="bold" fill="#ffffff" text-anchor="middle">3</text>
  <text x="360" y="190" font-family="Arial" font-size="11" fill="#cbd5e1" text-anchor="middle">DB Lookup</text>
  <circle cx="490" cy="150" r="20" fill="#8b5cf6"/>
  <text x="490" y="155" font-family="Arial" font-size="12" font-weight="bold" fill="#ffffff" text-anchor="middle">4</text>
  <text x="490" y="190" font-family="Arial" font-size="11" fill="#cbd5e1" text-anchor="middle">Bin Result</text>
</svg>
