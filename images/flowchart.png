<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 500 400" width="100%" height="100%">
  <rect width="500" height="400" rx="16" fill="#0f172a"/>
  <rect x="180" y="30" width="140" height="40" rx="20" fill="#10b981"/>
  <text x="250" y="55" font-family="Arial" font-size="14" font-weight="bold" fill="#ffffff" text-anchor="middle">START</text>
  <rect x="150" y="100" width="200" height="40" rx="6" fill="#0284c7"/>
  <text x="250" y="125" font-family="Arial" font-size="13" font-weight="bold" fill="#ffffff" text-anchor="middle">Enter Waste Query</text>
  <polygon points="250,170 320,210 250,250 180,210" fill="#f59e0b"/>
  <text x="250" y="215" font-family="Arial" font-size="13" font-weight="bold" fill="#ffffff" text-anchor="middle">Found?</text>
  <rect x="330" y="270" width="140" height="50" rx="6" fill="#10b981"/>
  <text x="400" y="300" font-family="Arial" font-size="12" font-weight="bold" fill="#ffffff" text-anchor="middle">Category &amp; Bin</text>
  <rect x="30" y="270" width="140" height="50" rx="6" fill="#ef473a"/>
  <text x="100" y="300" font-family="Arial" font-size="12" font-weight="bold" fill="#ffffff" text-anchor="middle">Unknown Item</text>
  <line x1="250" y1="70" x2="250" y2="100" stroke="#ffffff" stroke-width="2"/>
  <line x1="250" y1="140" x2="250" y2="170" stroke="#ffffff" stroke-width="2"/>
</svg>
