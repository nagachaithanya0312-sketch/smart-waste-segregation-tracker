<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 600 450" width="100%" height="100%">
  <defs>
    <linearGradient id="heroBg" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#10b981" stop-opacity="0.15" />
      <stop offset="100%" stop-color="#0284c7" stop-opacity="0.1" />
    </linearGradient>
    <linearGradient id="greenBinGrad" x1="0%" y1="0%" x2="0%" y2="100%">
      <stop offset="0%" stop-color="#34d399" />
      <stop offset="100%" stop-color="#059669" />
    </linearGradient>
    <linearGradient id="blueBinGrad" x1="0%" y1="0%" x2="0%" y2="100%">
      <stop offset="0%" stop-color="#38bdf8" />
      <stop offset="100%" stop-color="#0284c7" />
    </linearGradient>
    <linearGradient id="redBinGrad" x1="0%" y1="0%" x2="0%" y2="100%">
      <stop offset="0%" stop-color="#f87171" />
      <stop offset="100%" stop-color="#dc2626" />
    </linearGradient>
    <linearGradient id="yellowBinGrad" x1="0%" y1="0%" x2="0%" y2="100%">
      <stop offset="0%" stop-color="#fbbf24" />
      <stop offset="100%" stop-color="#d97706" />
    </linearGradient>
  </defs>

  <!-- Background Eco Glow Circle -->
  <circle cx="300" cy="225" r="200" fill="url(#heroBg)"/>
  <circle cx="300" cy="225" r="150" fill="none" stroke="#10b981" stroke-width="2" stroke-dasharray="8,8" opacity="0.4"/>

  <!-- Earth Platform -->
  <ellipse cx="300" cy="380" rx="240" ry="35" fill="#10b981" opacity="0.15" />
  <ellipse cx="300" cy="380" rx="180" ry="20" fill="#10b981" opacity="0.25" />

  <!-- Smart Bins Row -->
  <!-- 1. Organic Green Bin -->
  <g transform="translate(100, 200)">
    <rect x="0" y="20" width="70" height="110" rx="12" fill="url(#greenBinGrad)" />
    <polygon points="-5,15 75,15 65,0 5,0" fill="#047857"/>
    <rect x="15" y="45" width="40" height="6" rx="3" fill="#ffffff" opacity="0.8"/>
    <path d="M35 65 C25 65 20 75 35 85 C50 75 45 65 35 65 Z" fill="#ffffff"/>
    <text x="35" y="115" font-family="Arial" font-size="11" font-weight="bold" fill="#ffffff" text-anchor="middle">ORGANIC</text>
  </g>

  <!-- 2. Recyclable Blue Bin -->
  <g transform="translate(200, 180)">
    <rect x="0" y="20" width="75" height="130" rx="12" fill="url(#blueBinGrad)" />
    <polygon points="-5,15 80,15 70,0 5,0" fill="#0369a1"/>
    <path d="M37 55 L47 70 L27 70 Z" fill="#ffffff"/>
    <path d="M47 70 L42 85 L22 85 Z" fill="#ffffff" opacity="0.8"/>
    <text x="37" y="132" font-family="Arial" font-size="12" font-weight="bold" fill="#ffffff" text-anchor="middle">RECYCLE</text>
  </g>

  <!-- 3. Hazardous Red Bin -->
  <g transform="translate(315, 200)">
    <rect x="0" y="20" width="70" height="110" rx="12" fill="url(#redBinGrad)" />
    <polygon points="-5,15 75,15 65,0 5,0" fill="#b91c1c"/>
    <circle cx="35" cy="65" r="14" fill="#ffffff" opacity="0.9"/>
    <path d="M35 57 L35 70 M35 73 L35 76" stroke="#dc2626" stroke-width="3" stroke-linecap="round"/>
    <text x="35" y="115" font-family="Arial" font-size="10" font-weight="bold" fill="#ffffff" text-anchor="middle">HAZARD</text>
  </g>

  <!-- 4. E-Waste Yellow Bin -->
  <g transform="translate(415, 210)">
    <rect x="0" y="20" width="70" height="100" rx="12" fill="url(#yellowBinGrad)" />
    <polygon points="-5,15 75,15 65,0 5,0" fill="#b45309"/>
    <rect x="25" y="55" width="20" height="14" rx="2" fill="#ffffff"/>
    <line x1="35" y1="69" x2="35" y2="76" stroke="#ffffff" stroke-width="3"/>
    <text x="35" y="108" font-family="Arial" font-size="11" font-weight="bold" fill="#ffffff" text-anchor="middle">E-WASTE</text>
  </g>

  <!-- Floating AI Scanning Ray -->
  <path d="M300 50 L100 200 L485 210 Z" fill="url(#heroBg)" opacity="0.4"/>
  <circle cx="300" cy="50" r="28" fill="#10b981"/>
  <path d="M290 50 L310 50 M300 40 L300 60" stroke="#ffffff" stroke-width="3"/>
</svg>
